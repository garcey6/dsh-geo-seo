{
  "name": "dsh-geo-seo",
  "version": "0.1.0",
  "description": "GEO/SEO health check for DSH plugin repositories: score docs against a versioned rule pack, then generate llms.txt, ai.txt and JSON-LD from the same verified facts.",
  "type": "module",
  "license": "MIT",
  "author": {
    "name": "garcey",
    "url": "https://github.com/garcey6"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/garcey6/dsh-geo-seo.git"
  },
  "homepage": "https://github.com/garcey6/dsh-geo-seo#readme",
  "bugs": {
    "url": "https://github.com/garcey6/dsh-geo-seo/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "geo",
    "seo",
    "llms-txt",
    "structured-data",
    "documentation-audit"
  ],
  "engines": {
    "node": ">=22.6",
    "dsh": ">=0.2.2-rc.5"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "bin": {
    "geo-seo": "dist/src/cli/main.js"
  },
  "main": "./dist/src/index.js",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./core": {
      "types": "./dist/src/core/index.d.ts",
      "default": "./dist/src/core/index.js"
    },
    "./client": "./client/index.js",
    "./icon": "./icon.svg",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    },
    "manifestVersion": 1
  },
  "files": [
    "dist",
    "client",
    "assets",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "market",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node ./node_modules/typescript/bin/tsc -p tsconfig.json",
    "check:types": "node ./node_modules/typescript/bin/tsc -p tsconfig.json --noEmit",
    "test": "node --test \"dist/test/*.test.js\"",
    "test:build": "node ./node_modules/typescript/bin/tsc -p tsconfig.json && node --test \"dist/test/*.test.js\"",
    "selftest": "node ./dist/src/cli/main.js check --dir ./examples/sample-plugin --format text",
    "market:index": "node ./scripts/build-market-index.mjs",
    "release": "node ./scripts/release.mjs",
    "prepublishOnly": "node ./node_modules/typescript/bin/tsc -p tsconfig.json"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "typescript": "5.6.3"
  }
}
